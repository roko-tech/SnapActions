{
  "manifest_version": 3,
  "name": "SnapActions Browser Selection",
  "version": "1.0.0",
  "description": "Read highlighted text directly for the SnapActions Windows toolbar, without using the clipboard.",
  "minimum_chrome_version": "106",
  "key": "",
  "permissions": ["nativeMessaging", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "SnapActions: reconnect browser selection" }
}
