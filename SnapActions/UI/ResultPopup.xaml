<Window x:Class="SnapActions.UI.ResultPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        MaxWidth="480" MaxHeight="500" ShowActivated="False">

    <Border Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1" CornerRadius="10" Padding="12"
            MinWidth="200" MinHeight="60">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" Opacity="0.4" ShadowDepth="4" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <DockPanel Margin="0,0,0,8">
                <TextBlock x:Name="TitleText" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="X" Width="20" Height="20" FontSize="10"
                        Background="Transparent" Foreground="{DynamicResource TextSecondaryBrush}"
                        BorderThickness="0" Click="Close_Click" Cursor="Hand"/>
            </DockPanel>

            <TextBlock x:Name="SourceText" Visibility="Collapsed" TextWrapping="Wrap" MaxHeight="60"
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8"/>
            <TextBlock x:Name="LoadingText" Text="Loading..." FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Visible"/>

            <ScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="ResultText" FontSize="13" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}" Visibility="Collapsed"/>
            </ScrollViewer>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,8,0,0">
                <Button x:Name="CopyButton" Content="Copy result" Visibility="Collapsed" Padding="12,4"
                        Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Click="Copy_Click" Cursor="Hand"/>
                <Button x:Name="RetryButton" Content="Retry" Visibility="Collapsed"
                        Margin="8,0,0,0" Padding="12,4"
                        Background="{DynamicResource SurfaceBrush}"
                        Foreground="{DynamicResource TextBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Click="Retry_Click" Cursor="Hand"/>
                <Button x:Name="ReplaceButton" Content="Replace selection" Visibility="Collapsed"
                        Margin="8,0,0,0" Padding="12,4" Click="Replace_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
