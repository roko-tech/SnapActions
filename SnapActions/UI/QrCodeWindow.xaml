<Window x:Class="SnapActions.UI.QrCodeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QR code" Width="370" Height="450" MinWidth="300" MinHeight="350"
        Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="QR code · generated on this device" Margin="0,0,0,12"/>
        <Image x:Name="QrImage" Grid.Row="1" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="QR code"/>
        <TextBlock x:Name="PayloadText" Grid.Row="2" TextWrapping="Wrap" MaxHeight="50" Margin="0,10"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Copy image" Click="Copy_Click" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Save PNG" Click="Save_Click" Padding="12,6"/>
        </StackPanel>
    </Grid>
</Window>
