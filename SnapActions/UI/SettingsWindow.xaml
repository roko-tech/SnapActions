<Window x:Class="SnapActions.UI.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 FontSize="13" Title="SnapActions Settings" Width="740" Height="740" MinWidth="620" MinHeight="500"
 WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
 TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <Style x:Key="SettingsHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="Margin" Value="0,18,0,8"/></Style>
 </Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="SnapActions" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="Make selected text useful." Margin="0,4,0,18"/></StackPanel>
 <DockPanel Grid.Row="1" Margin="0,0,0,12"><TextBlock x:Name="SearchStatusText" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"/><TextBlock Text="Search settings" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox x:Name="SettingsSearchBox" Padding="10,7" AutomationProperties.Name="Search settings" ToolTip="Search settings by name" TextChanged="SettingsSearch_Changed"/></DockPanel>
 <TabControl x:Name="SettingsTabs" Grid.Row="2" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}">
<TabItem Header="General"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="16">
                <!-- General -->
                <TextBlock Text="GENERAL" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <CheckBox x:Name="EnabledCheck" Content="Enabled"
                          Foreground="{DynamicResource TextBrush}" Margin="0,4"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                <CheckBox x:Name="AutoStartCheck" Content="Start with Windows"
                          Foreground="{DynamicResource TextBrush}" Margin="0,4"
                          Checked="AutoStart_Changed" Unchecked="AutoStart_Changed"/>
                <CheckBox x:Name="ReplaceSelectionCheck"
                          Content="Prefer Replace in the keyboard palette (editable selections)"
                          Foreground="{DynamicResource TextBrush}" Margin="0,4"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                <CheckBox x:Name="RestoreClipboardCheck"
                          Content="Restore previous clipboard ~3 s after a copy action"
                          ToolTip="When you click a toolbar action that copies text (Format JSON, Convert Color, etc.), the result lands on your clipboard. With this on, the previous clipboard contents are put back about 3 seconds later — long enough for you to paste the result first."
                          Foreground="{DynamicResource TextBrush}" Margin="0,4"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                <CheckBox x:Name="OnlineLookupsCheck"
                          Content="Allow online lookups (Translate / Dictionary / Currency)"
                          ToolTip="Translate opens Google Translate inside the app. Dictionary and Currency use dictionaryapi.dev and open.er-api.com over HTTPS. With this off, they ask before sending your selection."
                          Foreground="{DynamicResource TextBrush}" Margin="0,4"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                <CheckBox x:Name="CaptureOnMouseSelectionCheck"
                          Content="Show toolbar automatically when I select text"
                          ToolTip="Automatic selection capture uses the browser companion or UI Automation and never copies or touches your clipboard. If an app does not expose selected text, use the Ctrl+C trigger below."
                          Foreground="{DynamicResource TextBrush}" Margin="0,4"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                <CheckBox x:Name="CaptureOnCtrlCCheck"
                          Content="Show toolbar when I press Ctrl+C"
                          ToolTip="When on, copying text with Ctrl+C also pops the toolbar for it. This reads what you just copied — no synthetic keystroke and no clipboard clearing — so it won't interfere with other apps."
                          Foreground="{DynamicResource TextBrush}" Margin="0,4"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>

<Expander Header="Advanced timing and paste gestures" Margin="0,12,0,4"><StackPanel>                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Show delay:" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="ShowDelayCombo" Width="120"
                              SelectionChanged="ShowDelay_Changed" AutomationProperties.Name="ShowDelayCombo">
                        <ComboBoxItem Content="Instant" Tag="0"/>
                        <ComboBoxItem Content="100 ms" Tag="100"/>
                        <ComboBoxItem Content="200 ms" Tag="200"/>
                        <ComboBoxItem Content="300 ms" Tag="300"/>
                        <ComboBoxItem Content="500 ms" Tag="500"/>
                        <ComboBoxItem Content="1 second" Tag="1000"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Multi-click delay:" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="MultiClickCombo" Width="120"
                              SelectionChanged="MultiClick_Changed" AutomationProperties.Name="MultiClickCombo">
                        <ComboBoxItem Content="Instant" Tag="0"/>
                        <ComboBoxItem Content="100 ms" Tag="100"/>
                        <ComboBoxItem Content="200 ms" Tag="200"/>
                        <ComboBoxItem Content="300 ms" Tag="300"/>
                        <ComboBoxItem Content="400 ms" Tag="400"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Paste mode:" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="PasteModeCombo" Width="120"
                              SelectionChanged="PasteMode_Changed"
                              ToolTip="How to summon the paste menu (the menu that appears with no selection, offering Paste / Paste as transform / etc.)" AutomationProperties.Name="PasteModeCombo">
                        <ComboBoxItem Content="Long-press" Tag="longpress"/>
                        <ComboBoxItem Content="Double-click" Tag="doubleclick"/>
                        <ComboBoxItem Content="Off" Tag="off"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Long-press duration:" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="LongPressCombo" Width="120"
                              SelectionChanged="LongPress_Changed"
                              ToolTip="How long to hold the mouse button to open paste mode (only applies when Paste mode = Long-press)" AutomationProperties.Name="LongPressCombo">
                        <ComboBoxItem Content="300 ms" Tag="300"/>
                        <ComboBoxItem Content="500 ms" Tag="500"/>
                        <ComboBoxItem Content="750 ms" Tag="750"/>
                        <ComboBoxItem Content="1 second" Tag="1000"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Auto-dismiss after:" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="DismissTimeCombo" Width="120"
                              SelectionChanged="DismissTime_Changed" AutomationProperties.Name="DismissTimeCombo">
                        <ComboBoxItem Content="3 seconds" Tag="3000"/>
                        <ComboBoxItem Content="5 seconds" Tag="5000"/>
                        <ComboBoxItem Content="8 seconds" Tag="8000"/>
                        <ComboBoxItem Content="15 seconds" Tag="15000"/>
                        <ComboBoxItem Content="30 seconds" Tag="30000"/>
                        <ComboBoxItem Content="Never" Tag="0"/>
                    </ComboBox>
                </StackPanel>

</StackPanel></Expander><TextBlock Text="APPEARANCE" Style="{StaticResource SettingsHeading}"/>
<ComboBox x:Name="ThemeCombo" Width="200" HorizontalAlignment="Left" AutomationProperties.Name="Color theme" SelectionChanged="Theme_Changed">
  <ComboBoxItem Content="Follow Windows" Tag="system"/><ComboBoxItem Content="Light" Tag="light"/><ComboBoxItem Content="Dark" Tag="dark"/>
</ComboBox>
<TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Text="Press Ctrl+Shift+Space to search actions with the keyboard. Select an action to preview it, then choose Copy or Replace. If text cannot be read, the palette lets you enter it."/>

</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Actions"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="16">
                <!-- Action Categories -->
                <TextBlock Text="ACTIONS" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,18,0,6"/>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Suggested actions on toolbar:" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="MaxInlineCombo" Width="80"
                              SelectionChanged="MaxInline_Changed"
                              ToolTip="Applies immediately in every app, including browsers. Pinned actions do not count toward this limit." AutomationProperties.Name="Suggested actions on toolbar">
                        <ComboBoxItem Content="1" Tag="1"/>
                        <ComboBoxItem Content="2" Tag="2"/>
                        <ComboBoxItem Content="3" Tag="3"/>
                        <ComboBoxItem Content="4" Tag="4"/>
                        <ComboBoxItem Content="6" Tag="6"/>
                        <ComboBoxItem Content="8" Tag="8"/>
                    </ComboBox>
                </StackPanel>
                <TextBlock Text="Pins stay first and do not count toward this limit. Pins that cannot fit on screen go in …. Drag actions onto the toolbar to pin them; use its gear to find hidden actions."
                           TextWrapping="Wrap" FontSize="11" Margin="0,0,0,8" Foreground="{DynamicResource TextSecondaryBrush}"/>

                <CheckBox x:Name="ShowTransformCheck" Content="Text Transforms"
                          Foreground="{DynamicResource TextBrush}" Margin="0,4"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                <CheckBox x:Name="ShowEncodeCheck" Content="Encode/Decode"
                          Foreground="{DynamicResource TextBrush}" Margin="0,4"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                <CheckBox x:Name="ShowSearchCheck" Content="Search engines"
                          Foreground="{DynamicResource TextBrush}" Margin="0,4"
                          Checked="Setting_Changed" Unchecked="Setting_Changed"/>


</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Languages"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="16">
                <!-- Language (search filter + translate/dictionary target) -->
                <TextBlock Text="LANGUAGE" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,18,0,2"/>
                <TextBlock Text="Search language is independent of translation and dictionary preferences."
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal">
                    <ComboBox x:Name="LanguageCombo" Width="200"
                              SelectionChanged="Language_Changed" AutomationProperties.Name="LanguageCombo">
                        <ComboBoxItem Content="No filter" Tag=""/>
                        <ComboBoxItem Content="English" Tag="en"/>
                        <ComboBoxItem Content="Arabic" Tag="ar"/>
                        <ComboBoxItem Content="Spanish" Tag="es"/>
                        <ComboBoxItem Content="French" Tag="fr"/>
                        <ComboBoxItem Content="German" Tag="de"/>
                        <ComboBoxItem Content="Japanese" Tag="ja"/>
                        <ComboBoxItem Content="Korean" Tag="ko"/>
                        <ComboBoxItem Content="Chinese" Tag="zh"/>
                        <ComboBoxItem Content="Portuguese" Tag="pt"/>
                        <ComboBoxItem Content="Russian" Tag="ru"/>
                        <ComboBoxItem Content="Turkish" Tag="tr"/>
                        <ComboBoxItem Content="Hindi" Tag="hi"/>
                        <ComboBoxItem Content="Italian" Tag="it"/>
                    </ComboBox>
                </StackPanel>

<TextBlock Text="Translate from" Margin="0,12,0,4"/>
<ComboBox x:Name="TranslationSourceCombo" Width="230" HorizontalAlignment="Left" AutomationProperties.Name="Translation source language" DisplayMemberPath="Name" SelectedValuePath="Code" SelectionChanged="LookupLanguage_Changed"/>
<TextBlock Text="Translate to" Margin="0,8,0,4"/>
<ComboBox x:Name="TranslationTargetCombo" Width="230" HorizontalAlignment="Left" AutomationProperties.Name="Translation target language" DisplayMemberPath="Name" SelectedValuePath="Code" SelectionChanged="LookupLanguage_Changed"/>
<TextBlock Text="Dictionary language" Margin="0,8,0,4"/>
<ComboBox x:Name="DictionaryCombo" Width="230" HorizontalAlignment="Left" AutomationProperties.Name="Dictionary language" SelectionChanged="LookupLanguage_Changed"><ComboBoxItem Content="English" Tag="en"/></ComboBox>
<TextBlock FontSize="12" TextWrapping="Wrap" Margin="0,6,0,8" Text="The dictionary supports English. Translate opens Google Translate inside a popup for selections up to 500 UTF-8 bytes. Choose starting languages here, then use the page's language and copy controls."/>
                <!-- Target Currency -->
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Convert to:" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="CurrencyCombo" Width="120"
                              SelectionChanged="Currency_Changed" AutomationProperties.Name="CurrencyCombo">
                        <ComboBoxItem Content="USD" Tag="USD"/>
                        <ComboBoxItem Content="EUR" Tag="EUR"/>
                        <ComboBoxItem Content="GBP" Tag="GBP"/>
                        <ComboBoxItem Content="SAR" Tag="SAR"/>
                        <ComboBoxItem Content="AED" Tag="AED"/>
                        <ComboBoxItem Content="KWD" Tag="KWD"/>
                        <ComboBoxItem Content="JPY" Tag="JPY"/>
                        <ComboBoxItem Content="CAD" Tag="CAD"/>
                        <ComboBoxItem Content="AUD" Tag="AUD"/>
                        <ComboBoxItem Content="CHF" Tag="CHF"/>
                        <ComboBoxItem Content="CNY" Tag="CNY"/>
                        <ComboBoxItem Content="INR" Tag="INR"/>
                        <ComboBoxItem Content="BRL" Tag="BRL"/>
                        <ComboBoxItem Content="KRW" Tag="KRW"/>
                        <ComboBoxItem Content="TRY" Tag="TRY"/>
                    </ComboBox>
                </StackPanel>

                <!-- Search Engines -->
                <TextBlock Text="SEARCH ENGINES" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,18,0,6"/>
                <StackPanel x:Name="SearchEnginesPanel" Margin="0,0,0,4"/>

                <!-- Add custom search engine -->
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6"
                        Padding="10" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Text="Add Custom Search Engine" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Name:" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" Width="50"/>
                            <TextBox x:Name="CustomNameBox" Width="180"
                                     Background="{DynamicResource BackgroundBrush}"
                                     Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" Padding="4,2" AutomationProperties.Name="CustomNameBox"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="URL:" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" Width="50"/>
                            <TextBox x:Name="CustomUrlBox" Width="350"
                                     Background="{DynamicResource BackgroundBrush}"
                                     Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" Padding="4,2" AutomationProperties.Name="CustomUrlBox"/>
                        </StackPanel>
                        <TextBlock Text="Use {0} for query, {1} for language. Example: https://site.com/search?q={0}&amp;lang={1}"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="50,2,0,4" TextWrapping="Wrap"/>
                        <Button Content="Add" HorizontalAlignment="Left" Margin="50,2,0,0"
                                Padding="16,4" Click="AddCustomEngine_Click"
                                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource BackgroundBrush}"
                                BorderThickness="0"/>
                    </StackPanel>
                </Border>


</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Custom"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="16">
                <!-- Custom Actions -->
                <TextBlock Text="CUSTOM ACTIONS" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,18,0,6"/>
                <StackPanel x:Name="UserActionsPanel" Margin="0,0,0,4"/>
                <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="6" Padding="10" Margin="0,6,0,0">
                    <StackPanel>
                        <TextBlock Text="Add Custom Action" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Name:" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" Width="70"/>
                            <TextBox x:Name="UserActionNameBox" Width="180"
                                     Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" Padding="4,2" AutomationProperties.Name="UserActionNameBox"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="URL:" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" Width="70"/>
                            <TextBox x:Name="UserActionUrlBox" Width="340"
                                     Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" Padding="4,2" AutomationProperties.Name="UserActionUrlBox"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Action:" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" Width="70"/>
                            <ComboBox x:Name="UserActionKindCombo" Width="170" AutomationProperties.Name="UserActionKindCombo">
                                <ComboBoxItem Content="Open in browser" Tag="openurl" IsSelected="True"/>
                                <ComboBoxItem Content="Fetch &amp; show result" Tag="fetchtext"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="Applies to:" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" Width="70"/>
                            <ComboBox x:Name="UserActionTypeCombo" Width="170" AutomationProperties.Name="UserActionTypeCombo">
                                <ComboBoxItem Content="Any selection" Tag="" IsSelected="True"/>
                                <ComboBoxItem Content="URLs" Tag="Url"/>
                                <ComboBoxItem Content="Emails" Tag="Email"/>
                                <ComboBoxItem Content="IP addresses" Tag="IpAddress"/>
                                <ComboBoxItem Content="File paths" Tag="FilePath"/>
                                <ComboBoxItem Content="JSON" Tag="Json"/>
                                <ComboBoxItem Content="UUIDs" Tag="Uuid"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="JSON field:" Foreground="{DynamicResource TextBrush}"
                                       VerticalAlignment="Center" Width="70"/>
                            <TextBox x:Name="UserActionFieldBox" Width="170"
                                     Background="{DynamicResource BackgroundBrush}" Foreground="{DynamicResource TextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}" Padding="4,2" AutomationProperties.Name="UserActionFieldBox"/>
                            <TextBlock Text="optional, for Fetch" FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                                       Margin="6,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Use {0} for the selected text. Example: https://api.github.com/users/{0}"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="70,2,0,4" TextWrapping="Wrap"/>
                        <Button Content="Add" HorizontalAlignment="Left" Margin="70,2,0,0"
                                Padding="16,4" Click="AddUserAction_Click"
                                Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource BackgroundBrush}"
                                BorderThickness="0"/>
                    </StackPanel>
                </Border>

<TextBlock Text="SAVED TEXT RECIPES" Style="{StaticResource SettingsHeading}"/>
<TextBlock TextWrapping="Wrap" Text="Chain local text operations, preview the result, and save the chain as an action. Recipes never run network requests or paste intermediate results."/>
<StackPanel x:Name="RecipesPanel" Margin="0,8"/>
<Button Content="Create text recipe…" HorizontalAlignment="Left" Padding="12,6" Click="CreateRecipe_Click"/>

</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Apps"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="16">
                <!-- App Profiles -->
                <TextBlock Text="APP PROFILES" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,18,0,6"/>
                <TextBlock Text="Hide specific actions when a chosen app is in the foreground."
                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" TextWrapping="Wrap"/>
                <StackPanel x:Name="AppProfilesPanel" Margin="0,0,0,4"/>
                <Button Content="Configure app profiles..." HorizontalAlignment="Left" Margin="0,2,0,0"
                        Padding="10,2" FontSize="12" Click="ConfigureAppProfiles_Click"
                        Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}" BorderBrush="{DynamicResource BorderBrush}" Cursor="Hand"/>

                <!-- Excluded Apps -->
                <TextBlock Text="EXCLUDED APPS" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,18,0,6"/>
                <DockPanel Margin="0,0,0,4">
                    <Button DockPanel.Dock="Right" Content="Add running app..."
                            Padding="10,2" FontSize="12"
                            Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Click="AddRunningApp_Click" Cursor="Hand"/>
                    <TextBlock Text="One process name per line"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox x:Name="ExcludedAppsBox" AcceptsReturn="True" Height="80"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         Padding="8" FontFamily="Consolas" FontSize="12"
                         TextChanged="ExcludedApps_Changed" AutomationProperties.Name="ExcludedAppsBox"/>

</StackPanel></ScrollViewer></TabItem>
<TabItem Header="Browser"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="16">
<TextBlock Text="BROWSER COMPANION" Style="{StaticResource SettingsHeading}"/>
<TextBlock TextWrapping="Wrap" Text="Read the browser's actual selection, including mixed Arabic and English text. The companion reads the active tab only when you select text or invoke the palette."/>
<TextBlock Text="1. Keep SnapActions.exe and its browser-extension folder together in a permanent location." TextWrapping="Wrap" Margin="0,14,0,6"/>
<WrapPanel><ComboBox x:Name="BrowserCombo" Width="130" SelectedIndex="0" AutomationProperties.Name="Browser" SelectionChanged="Browser_Changed"><ComboBoxItem Content="Brave"/><ComboBoxItem Content="Chrome"/><ComboBoxItem Content="Edge"/></ComboBox>
<Button Content="Register this copy" Click="RegisterBrowser_Click" Padding="12,4" Margin="8,0,0,0"/></WrapPanel>
<TextBlock Text="2. Open your browser's Extensions page, enable Developer mode, and choose Load unpacked. Select the browser-extension folder beside this app; the button below opens it for you. Reload the extension after updating SnapActions." TextWrapping="Wrap" Margin="0,14,0,6"/>
<Button Content="Open extension folder" Click="OpenExtension_Click" HorizontalAlignment="Left" Margin="0,6" Padding="12,4"/>
<TextBlock Text="3. Open the selection sample in that browser. Select ordinary text, mixed-direction text, and text inside its editor. The toolbar should show the exact selection." TextWrapping="Wrap" Margin="0,14,0,6"/>
<Button Content="Open selection sample" Click="OpenBrowserSample_Click" HorizontalAlignment="Left" Padding="12,4"/>
<TextBlock Text="CONNECTION AND CAPTURE HEALTH" Style="{StaticResource SettingsHeading}"/>
<TextBlock x:Name="BrowserStatusText" TextWrapping="Wrap" Margin="0,0,0,8" AutomationProperties.LiveSetting="Polite"/>
<TextBox x:Name="DiagnosticsBox" IsReadOnly="True" TextWrapping="Wrap" Padding="8" MinHeight="100" AutomationProperties.Name="Capture health and timing"/>
<Button Content="Refresh health" Click="RefreshBrowser_Click" HorizontalAlignment="Left" Margin="0,6" Padding="12,4"/>
<TextBlock FontSize="12" TextWrapping="Wrap" Text="Timings are a rolling sample from this session. Render-ready timing excludes screen paint. Diagnostics contain no selected text. A connection alone does not prove a page exposes its selection."/>

</StackPanel></ScrollViewer></TabItem>
</TabControl>
 <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <StackPanel VerticalAlignment="Center"><TextBlock x:Name="SaveStatusText" Text="Changes save automatically" AutomationProperties.LiveSetting="Polite"/><TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/></StackPanel>
 <StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="RetrySaveButton" Content="Retry save" Visibility="Collapsed" Click="Save_Click" Padding="14,7" Margin="0,0,8,0"/><Button Content="Close" Padding="20,7" Click="Close_Click"/></StackPanel>
 </Grid></Grid></Window>
